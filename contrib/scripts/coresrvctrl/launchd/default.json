{
  "root": "scripts/coresrvctrl",
  "actions": [
    {
      "id": "start_core",
      "label": "Start Core",
      "cmd": {
        "program": "/bin/sh",
        "args": [
          "${root}/launchd/service.sh",
          "start",
          "${scope}",
          "${service_name}"
        ]
      }
    },
    {
      "id": "stop_core",
      "label": "Stop Core",
      "cmd": {
        "program": "/bin/sh",
        "args": [
          "${root}/launchd/service.sh",
          "stop",
          "${scope}",
          "${service_name}"
        ]
      }
    },
    {
      "id": "restart_core",
      "label": "Restart Core",
      "cmd": {
        "program": "/bin/sh",
        "args": [
          "${root}/launchd/service.sh",
          "restart",
          "${scope}",
          "${service_name}"
        ]
      }
    },
    {
      "id": "status_core",
      "label": "Core Status",
      "cmd": {
        "program": "/bin/sh",
        "args": [
          "${root}/launchd/service.sh",
          "status",
          "${scope}",
          "${service_name}"
        ]
      }
    },
    {
      "id": "enable_autostart_core",
      "label": "Enable Autostart",
      "cmd": {
        "program": "/bin/sh",
        "args": [
          "${root}/launchd/service.sh",
          "enable-autostart",
          "${scope}",
          "${service_name}"
        ]
      }
    },
    {
      "id": "disable_autostart_core",
      "label": "Disable Autostart",
      "cmd": {
        "program": "/bin/sh",
        "args": [
          "${root}/launchd/service.sh",
          "disable-autostart",
          "${scope}",
          "${service_name}"
        ]
      }
    }
  ]
}
