{
  "platforms": [
    {
      "os": "linux",
      "default_controller": "systemd"
    },
    {
      "os": "macos",
      "default_controller": "launchd"
    },
    {
      "os": "windows",
      "default_controller": "nssm"
    }
  ],
  "templates": [
    {
      "os": "linux",
      "controller": "systemd",
      "scope": "system",
      "path": "systemd/system.json"
    },
    {
      "os": "linux",
      "controller": "systemd",
      "scope": "user",
      "path": "systemd/user.json"
    },
    {
      "os": "linux",
      "controller": "openrc",
      "scope": "system",
      "path": "openrc/system.json"
    },
    {
      "os": "linux",
      "controller": "openrc",
      "scope": "user",
      "path": "openrc/user.json"
    },
    {
      "os": "macos",
      "controller": "launchd",
      "scope": "system",
      "path": "launchd/system.json"
    },
    {
      "os": "macos",
      "controller": "launchd",
      "scope": "user",
      "path": "launchd/user.json"
    },
    {
      "os": "windows",
      "controller": "nssm",
      "scope": "system",
      "path": "windows/system.json"
    }
  ]
}
