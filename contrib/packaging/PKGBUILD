# Local patched build of clashtui 0.3.1 with the EIO/SIGABRT fix.
# Mirrors the AUR `clashtui` PKGBUILD, plus a patch applied in prepare().
pkgname=clashtui
pkgdesc="Mihomo (Clash.Meta) TUI Client"
url="https://github.com/JohanChane/clashtui"
license=("MIT")
arch=("x86_64")
pkgver=0.3.1
pkgrel=2
makedepends=("rust" "git")
depends=("gcc-libs" "glibc" "mihomo")
conflicts=("clashtui-bin")
provides=("clashtui")
source=("source::git+https://github.com/JohanChane/clashtui.git#tag=v${pkgver}"
        "sigabrt-eio-fix.patch")
md5sums=('SKIP' 'SKIP')
options=(!lto)

function prepare() {
	cd source
	export RUSTUP_TOOLCHAIN=stable
	git apply --verbose "$srcdir/sigabrt-eio-fix.patch"
	cargo fetch --target "$CARCH-unknown-linux-gnu"
}

function build() {
	cd source
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen --all-features --locked
}

function check() {
	cd source
	export RUSTUP_TOOLCHAIN=stable
	cargo test --release --frozen --all-features --locked
}

function package() {
	cd source
	install -Dm755 "target/release/clashtui" "${pkgdir}/usr/bin/clashtui"
	install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
