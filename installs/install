#!/usr/bin/env bash
# Bash 3.2 compatible. Run directly or source the functions without installing.

log_message() {
  local level="$1" color="$2" colors=0
  shift 2
  if [ -t 2 ] && [ -z "${NO_COLOR+x}" ] && [ "${TERM:-dumb}" != dumb ]; then
    if command -v tput >/dev/null 2>&1; then
      colors=$(tput colors 2>/dev/null) || colors=0
    else
      # Minimal systems such as Alpine may not provide tput.
      case "${TERM:-}" in xterm*|screen*|tmux*|rxvt*|linux|cygwin|ansi) colors=8 ;; esac
    fi
  fi
  case "$colors" in ''|*[!0-9]*) colors=0 ;; esac
  if [ "$colors" -ge 8 ]; then
    printf '\033[%sm[%s] %s\033[0m\n' "$color" "$level" "$*" >&2
  else
    printf '[%s] %s\n' "$level" "$*" >&2
  fi
}
log_info() { log_message INFO 32 "$@"; }
log_warn() { log_message WARN 33 "$@"; }
die() { log_message ERROR 31 "$@"; exit 1; }
command_exists() { command -v "$1" >/dev/null 2>&1; }

show_help() {
  cat <<'EOF'
Usage: bash installs/install [OPTIONS]

Install ClashTui and its core services on Linux or macOS.
Without options, ask for choices using the defaults below.

  -h, --help                 Show help
  -y, --yes, --no-prompt      Use defaults without asking; sudo must already work
  -u, --uninstall            Stop and remove the selected cores and ClashTui
  --service-controller TYPE  auto-detect, systemd, openrc, launchd (default: auto-detect)
  --contrib-dir PATH         Use this contrib directory (relative or absolute)
  --repo OWNER/REPO          Download repository (default: JohanChane/clashtui)
  --version TAG             Release tag for downloads (default: latest)

  --is-user                 Install under ~/.local/clashtui (default: system) [interactive]
  --core TYPE               mihomo, sing-box, all (default: all) [interactive]
  --templates yes|no         Install templates for selected cores (default: yes) [interactive]
  --rules-dat yes|no         Download mihomo GeoIP/GeoSite data (default: yes) [interactive]

[interactive]: Prompt when applicable unless supplied or --no-prompt is used.

Examples:
  bash installs/install                              # Interactive install
  bash installs/install --yes                        # Install with defaults
  bash installs/install --is-user --core sing-box     # User install, sing-box only
  bash installs/install --version TAG                # Download from release TAG
  bash installs/install --uninstall --core all        # Uninstall both cores and ClashTui

  # Local resources with OpenRC
  bash installs/install --contrib-dir ./contrib --service-controller openrc
EOF
}

# This input boundary writes only main's local options. The installation functions
# below receive their inputs as arguments; they never change those options.
parse_options() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) show_help; exit 0 ;;
      -y|--yes|--no-prompt) no_prompt=true ;;
      -u|--uninstall) action=uninstall ;;
      --is-user) scope=user; scope_set=true ;;
      --core|--service-controller|--templates|--rules-dat|--contrib-dir|--repo|--version)
        [ "$#" -ge 2 ] && [ -n "$2" ] && [[ "$2" != -* ]] || die "$1 requires a value"
        case "$1" in
          --core) selection=$2; core_set=true ;;
          --service-controller) backend=$2 ;;
          --templates) templates=$2; templates_set=true ;;
          --rules-dat) rules_dat=$2; rules_set=true ;;
          --contrib-dir) contrib_path=$2 ;;
          --repo) repo=$2 ;;
          --version) version=$2 ;;
        esac
        shift
        ;;
      *) die "Unknown option: $1 (see --help)" ;;
    esac
    shift
  done
  case "$selection" in all|mihomo|sing-box) ;; *) die 'Invalid --core: use all, mihomo, sing-box' ;; esac
  case "$backend" in auto-detect|systemd|openrc|launchd) ;; *) die 'Invalid --service-controller' ;; esac
  case "$templates:$rules_dat" in yes:yes|yes:no|no:yes|no:no) ;; *) die '--templates and --rules-dat accept yes or no' ;; esac
  [[ "$repo" =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]] || die 'Invalid --repo: expected OWNER/REPO'
  [[ "$version" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || die 'Invalid --version: expected a release tag or latest'
}

ask_choice() {
  local label="$1" default="$2" choices="$3" answer
  if [ -t 0 ]; then
    exec 3<&0
  elif ! { exec 3</dev/tty; } 2>/dev/null; then
    die 'Interactive mode requires a terminal. Use --no-prompt to accept defaults.'
  fi
  while :; do
    printf '%s (%s) [%s]: ' "$label" "$choices" "$default" >&2
    IFS= read -r answer <&3 || die 'Input ended before a choice was made'
    answer=${answer:-$default}
    case "$answer" in */*) log_warn "Choose one of: $choices"; continue ;; esac
    case "/$choices/" in
      *"/$answer/"*) printf '%s\n' "$answer"; exec 3<&-; return ;;
      *) log_warn "Choose one of: $choices" ;;
    esac
  done
}

resolve_choices() {
  $no_prompt && return 0
  $scope_set || scope=$(ask_choice 'Install mode' "$scope" system/user)
  $core_set || selection=$(ask_choice 'Cores' "$selection" all/mihomo/sing-box)
  if [ "$action" = uninstall ]; then
    [ "$(ask_choice "Uninstall $selection in $scope mode?" no yes/no)" = yes ] || exit 0
  else
    $templates_set || templates=$(ask_choice 'Install templates' "$templates" yes/no)
    if [ "$selection" != sing-box ]; then
      $rules_set || rules_dat=$(ask_choice 'Download mihomo rules-dat' "$rules_dat" yes/no)
    fi
  fi
}

selected_cores() {
  case "$1" in all) printf '%s\n' mihomo sing-box ;; *) printf '%s\n' "$1" ;; esac
}

core_extension() { if [ "$1" = mihomo ]; then printf yaml; else printf json; fi; }

resolve_backend() {
  local requested="$1" os
  os=$(uname -s)
  case "$os:$requested" in
    Darwin:auto-detect|Darwin:launchd) printf launchd ;;
    Linux:systemd|Linux:openrc) printf '%s' "$requested" ;;
    Linux:auto-detect)
      if [ -d /run/openrc ] || { command_exists rc-service && ! command_exists systemctl; }; then
        printf openrc
      elif command_exists systemctl; then
        printf systemd
      else
        die 'No supported service controller found; use --service-controller'
      fi
      ;;
    *) die "Unsupported OS/service controller: $os/$requested" ;;
  esac
}

installation_dir() {
  case "$1:$2" in
    user:*) printf '%s/.local/clashtui' "$HOME" ;;
    system:launchd) printf /usr/local/opt/clashtui ;;
    *) printf /opt/clashtui ;;
  esac
}

service_dir() {
  case "$1:$2" in
    user:systemd) printf '%s/systemd/user' "${XDG_CONFIG_HOME:-$HOME/.config}" ;;
    system:systemd) printf /usr/lib/systemd/system ;;
    user:openrc) printf '%s/rc/init.d' "${XDG_CONFIG_HOME:-$HOME/.config}" ;;
    system:openrc) printf /etc/init.d ;;
    user:launchd) printf '%s/Library/LaunchAgents' "$HOME" ;;
    system:launchd) printf /Library/LaunchDaemons ;;
  esac
}

user_config_dir() { printf '%s' "${CLASHTUI_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/clashtui}"; }

as_scope() {
  local scope="$1"
  shift
  if [ "$scope" = system ] && [ "$(id -u)" -ne 0 ]; then
    sudo -n -- "$@"
  else
    "$@"
  fi
}

preflight() {
  local scope="$1" backend="$2" no_prompt="$3" action="$4" tool value
  for value in "$HOME" "$(user_config_dir)" "${XDG_CONFIG_HOME:-$HOME/.config}"; do
    case "$value" in /*) ;; *) die "Expected an absolute path: $value" ;; esac
    case "$value" in *$'\n'*|*$'\r'*) die 'Paths must not contain newlines' ;; esac
  done
  for tool in install mktemp cp mv mkdir chmod tar; do
    command_exists "$tool" || die "Missing command: $tool"
  done
  case "$backend" in
    systemd) command_exists systemctl || die 'Missing command: systemctl' ;;
    launchd) command_exists launchctl || die 'Missing command: launchctl' ;;
    openrc)
      command_exists rc-service && command_exists rc-update || die 'OpenRC requires rc-service and rc-update'
      if [ "$scope" = user ]; then
        [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] || die 'OpenRC user services require XDG_RUNTIME_DIR'
        [[ "$(rc-service --help 2>&1)" == *--user* ]] || die 'This OpenRC version does not support user services'
      fi
      ;;
  esac
  if [ "$scope" = system ] && [ "$(id -u)" -ne 0 ]; then
    command_exists sudo || die 'System installation requires root or sudo'
    if $no_prompt; then
      sudo -n true || die 'sudo credentials required; run sudo -v first, or use --is-user'
    else
      sudo -v || die 'Cannot obtain sudo privileges'
    fi
  fi
  if [ "$action" = install ]; then
    log_info "Install $scope mode using $backend"
  fi
}

# Filesystem writes are confined to these helpers and the install/uninstall steps.
# Copy to a sibling first, then rename, so an interrupted copy keeps the old file.
publish_file() {
  local source="$1" destination="$2" mode="$3" scope="$4" backup index=1 temporary
  as_scope "$scope" mkdir -p "$(dirname "$destination")"
  if [ -e "$destination" ] || [ -L "$destination" ]; then
    [ ! -d "$destination" ] || die "Refusing to replace directory: $destination"
    if [ ! -L "$destination" ] && cmp -s "$source" "$destination"; then
      as_scope "$scope" chmod "$mode" "$destination"
      return
    fi
    backup="$destination.bak.$index"
    while [ -e "$backup" ] || [ -L "$backup" ]; do
      index=$((index + 1)); backup="$destination.bak.$index"
    done
    as_scope "$scope" cp -Pp "$destination" "$backup"
    log_info "Backup: $backup"
  fi
  temporary=$(as_scope "$scope" mktemp "$destination.tmp.XXXXXX")
  if ! as_scope "$scope" install -m "$mode" "$source" "$temporary" ||
     ! as_scope "$scope" mv -f "$temporary" "$destination"; then
    as_scope "$scope" rm -f "$temporary"
    die "Cannot install: $destination"
  fi
}

fetch() {
  local url="$1" destination="$2"
  command_exists curl || die 'Downloads require curl'
  log_info "Download: $url"
  curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 \
    --output "$destination" "$url"
}

release_tag() {
  local repo="$1" version="$2" work="$3" metadata tag
  if [ "$version" != latest ]; then printf '%s' "$version"; return; fi
  metadata="$work/${repo//\//_}.release.json"
  if [ ! -f "$metadata" ]; then
    command_exists curl || die 'Downloads require curl'
    local -a headers
    headers=()
    if [ -n "${GITHUB_TOKEN:-}" ]; then headers=(-H "Authorization: Bearer $GITHUB_TOKEN"); fi
    curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 \
      ${headers[@]+"${headers[@]}"} "https://api.github.com/repos/$repo/releases/latest" -o "$metadata"
  fi
  tag=$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$metadata")
  [[ "$tag" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || die "Cannot determine latest release for $repo"
  printf '%s' "$tag"
}

local_contrib_dir() {
  local directory
  [ -n "${BASH_SOURCE[0]:-}" ] || return 0
  directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  if [ -d "$directory/contrib" ]; then printf '%s/contrib' "$directory"
  elif [ -d "$directory/../contrib" ]; then printf '%s/../contrib' "$directory"
  fi
}

prepare_contrib() {
  local repo="$1" version="$2" work="$3" directory="$4" tag resolved
  if [ -z "$directory" ]; then directory=$(local_contrib_dir); fi
  if [ -n "$directory" ]; then
    resolved=$(cd -- "$directory" >/dev/null && pwd -P) || die "Cannot access contrib directory: $directory"
    directory=$resolved
    log_info "Use local resources: $directory"
  else
    tag=$(release_tag "$repo" "$version" "$work")
    fetch "https://github.com/$repo/releases/download/$tag/contrib.tar.gz" "$work/contrib.tar.gz"
    mkdir -p "$work/resources"
    tar -xzf "$work/contrib.tar.gz" -C "$work/resources"
    directory="$work/resources/contrib"
  fi
  [ -d "$directory/scripts" ] && [ -d "$directory/default_configs" ] &&
    [ -d "$directory/templates" ] || die "Incomplete contrib resources: $directory"
  printf '%s' "$directory"
}

validate_contrib() {
  local directory="$1" selection="$2" scope="$3" backend="$4" templates="$5"
  local resource core extension suffix=
  for resource in default_configs/default_keymap.yaml default_configs/default_theme.yaml \
    "scripts/coresrvctrl/$backend/service.sh" "scripts/coresrvctrl/$backend/default.json" \
    scripts/clipboard/copy.sh scripts/files/open.sh; do
    [ -s "$directory/$resource" ] || die "Missing contrib resource: $resource"
  done
  if [ "$scope" = user ]; then suffix=_no_tun; fi
  for core in $(selected_cores "$selection"); do
    extension=$(core_extension "$core")
    resource="default_configs/$core/core_override_config$suffix.$extension"
    [ -s "$directory/$resource" ] || die "Missing contrib resource: $resource"
    if [ "$templates" = yes ]; then
      [ -d "$directory/templates/$core" ] || die "Missing contrib templates: $core"
    fi
  done
}

binary_platform() {
  local os arch
  case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) die 'Unsupported OS' ;; esac
  case "$(uname -m)" in
    x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;;
    armv7l|armhf) arch=armv7 ;; armv6l) arch=armv6 ;; i386|i686) arch=386 ;;
    *) die 'Unsupported CPU architecture' ;;
  esac
  printf '%s %s\n' "$os" "$arch"
}

existing_binary() {
  local name="$1" destination="$2" candidate
  if [ -f "$destination" ] && [ -x "$destination" ]; then printf '%s' "$destination"; return; fi
  candidate=$(command -v "$name" || true)
  if [ -z "$candidate" ] && [ "$name" = mihomo ]; then candidate=$(command -v clash-meta || true); fi
  if [ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ]; then
    case "$candidate" in /*) ;; *) candidate="$PWD/$candidate" ;; esac
    printf '%s' "$candidate"
  fi
}

prepare_binary() {
  local name="$1" destination="$2" repo="$3" version="$4" work="$5"
  local existing os arch tag asset upstream output platform
  existing=$(existing_binary "$name" "$destination")
  if [ -n "$existing" ]; then printf '%s' "$existing"; return; fi
  platform=$(binary_platform)
  read -r os arch <<< "$platform"
  upstream="$repo"
  case "$name" in
    mihomo) upstream=MetaCubeX/mihomo; version=latest ;;
    sing-box) upstream=SagerNet/sing-box; version=latest ;;
    clashtui) case "$arch" in amd64|arm64) ;; *) die "No ClashTui release binary for $arch; install it in PATH first" ;; esac ;;
  esac
  if [ "$os" = darwin ]; then
    case "$arch" in amd64|arm64) ;; *) die "Unsupported macOS architecture: $arch" ;; esac
  fi
  tag=$(release_tag "$upstream" "$version" "$work")
  output="$work/$name"
  if [ "$name" = sing-box ]; then
    asset="sing-box-${tag#v}-$os-$arch"
    fetch "https://github.com/$upstream/releases/download/$tag/$asset.tar.gz" "$work/$asset.tar.gz"
    tar -xzf "$work/$asset.tar.gz" -C "$work"
    cp "$work/$asset/sing-box" "$output"
  else
    if [ "$name:$arch" = mihomo:amd64 ]; then arch=amd64-v1; fi
    asset="$name-$os-$arch-$tag.gz"
    fetch "https://github.com/$upstream/releases/download/$tag/$asset" "$work/$asset"
    gzip -dc "$work/$asset" > "$output"
  fi
  [ -s "$output" ] || die "Downloaded binary is empty: $name"
  printf '%s' "$output"
}

install_binary() {
  local source="$1" destination="$2" scope="$3"
  if [ "$source" = "$destination" ]; then
    log_info "Keep binary: $destination"
  else
    # Copy PATH binaries instead of linking back through the install directory.
    publish_file "$source" "$destination" 755 "$scope"
  fi
}

create_system_account() {
  local name="$1" login_user="${SUDO_USER:-${USER:-$(id -un)}}"
  if ! id "$name" >/dev/null 2>&1; then
    if command_exists useradd; then
      getent group "$name" >/dev/null || as_scope system groupadd --system "$name"
      as_scope system useradd --system --no-create-home --gid "$name" --shell /bin/false "$name"
    else
      getent group "$name" >/dev/null || as_scope system addgroup -S "$name"
      as_scope system adduser -S -H -D -G "$name" -s /sbin/nologin "$name"
    fi
  fi
  if [ "$login_user" != root ]; then
    if command_exists usermod; then as_scope system usermod -a -G "$name" "$login_user"
    else as_scope system addgroup "$login_user" "$name"
    fi
  fi
}

fix_config_permissions() {
  local core="$1" directory="$2" backend="$3"
  case "$backend" in
    launchd) as_scope system chown -R root:admin "$directory" ;;
    *) as_scope system chown -R "$core:$core" "$directory" ;;
  esac
  as_scope system chmod -R g+rwX "$directory"
  as_scope system chmod g+s "$directory"
}

# YAML single-quoted scalars keep spaces, quotes, and special characters literal.
yaml_string() {
  local value="$1"
  value=${value//\'/\'\'}
  printf "'%s'" "$value"
}

render_config() {
  local directory="$1" core key extension
  for core in mihomo sing-box; do
    key=$core
    if [ "$core" = sing-box ]; then key=singbox; fi
    extension=$(core_extension "$core")
    cat <<EOF
$key:
  core:
    config_dir: $(yaml_string "$directory/$core/config")
    bin_path: $(yaml_string "$directory/$core/$core")
    config_path: $(yaml_string "$directory/$core/config/config.$extension")
  core_service:
    service_name: $(service_name "$core")
EOF
  done
  printf 'timeout: null\n'
}

render_provider_example() {
  cat <<'EOF'
# Define proxy-provider subscription URLs here, organized by group.
# In templates use ${PPG.<group>} to reference all providers in a group,
# or ${PPG.<group>.<provider>} for a specific one.
#
# Format:
#   <group-name>:
#     <provider-name>: "<subscription-url>"
#
# Clashtui's built-in templates only use the group level
# (e.g. ${PPG.pvd}, not ${PPG.pvd.pvd0}). Provider names
# (pvd0, pvd1, ...) are freely defined by the user.
#
# Example (following clashtui convention):
#   pvd:
#     pvd0: "https://example.com/sub1.yaml"
#     pvd1: "https://example.com/sub2.yaml"
EOF
}

install_user_config() {
  local contrib="$1" scope="$2" backend="$3" work="$4" config directory resource
  config=$(user_config_dir)
  directory=$(installation_dir "$scope" "$backend")
  render_config "$directory" > "$work/config.yaml"
  for resource in default_keymap.yaml default_theme.yaml; do
    publish_file "$contrib/default_configs/$resource" "$config/$resource" 644 user
  done
  publish_file "$contrib/scripts/coresrvctrl/$backend/service.sh" "$config/scripts/coresrvctrl/$backend/service.sh" 755 user
  for resource in clipboard/copy.sh files/open.sh; do
    publish_file "$contrib/scripts/$resource" "$config/scripts/$resource" 755 user
  done
  sed 's/"${scope}"/"'"$scope"'"/g' "$contrib/scripts/coresrvctrl/$backend/default.json" > "$work/scripts.json"
  publish_file "$work/scripts.json" "$config/scripts.json" 644 user
  publish_file "$work/config.yaml" "$config/config.yaml" 644 user
}

install_core_config() {
  local core="$1" scope="$2" backend="$3" contrib="$4" work="$5"
  local directory config extension override
  directory="$(installation_dir "$scope" "$backend")/$core/config"
  config="$(user_config_dir)/$core"
  extension=$(core_extension "$core")
  override="core_override_config.$extension"
  if [ "$scope" = user ]; then override="core_override_config_no_tun.$extension"; fi
  mkdir -p "$config/profiles" "$config/templates"
  publish_file "$contrib/default_configs/$core/$override" "$directory/config.$extension" 664 "$scope"
  publish_file "$contrib/default_configs/$core/$override" "$config/core_override_config.$extension" 644 user
  if [ ! -e "$config/template_proxy_providers.yaml" ]; then
    render_provider_example > "$work/template_proxy_providers.yaml"
    publish_file "$work/template_proxy_providers.yaml" "$config/template_proxy_providers.yaml" 644 user
  fi
}

install_templates() {
  local core="$1" contrib="$2" file destination
  destination="$(user_config_dir)/$core/templates"
  for file in "$contrib/templates/$core/"*; do
    [ -f "$file" ] || continue
    publish_file "$file" "$destination/$(basename "$file")" 644 user
  done
}

service_name() {
  case "$1" in
    mihomo) printf '%s\n' clashtui_mihomo ;;
    sing-box) printf '%s\n' clashtui_singbox ;;
    *) return 1 ;;
  esac
}

service_filename() {
  local backend="$1" name
  name=$(service_name "$2") || return 1
  case "$backend" in
    systemd) printf '%s.service\n' "$name" ;;
    launchd) printf '%s.plist\n' "$name" ;;
    openrc) printf '%s\n' "$name" ;;
    *) return 1 ;;
  esac
}

# Quote an ExecStart argument without allowing systemd variable/specifier expansion.
service_systemd_arg() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//%/%%}
  value=${value//\$/\$\$}
  printf '"%s"' "$value"
}

service_xml_text() {
  local value="$1"
  value=${value//&/\&amp;}
  value=${value//</\&lt;}
  value=${value//>/\&gt;}
  printf '%s' "$value"
}

# OpenRC sources init scripts, so keep each path a literal shell argument.
service_shell_arg() {
  local value="$1"
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

render_systemd() {
  local core="$1" scope="$2" install_dir="$3"
  local config_dir="$install_dir/$core/config" command_line restart_policy capabilities wanted_by
  command_line="$(service_systemd_arg "$install_dir/$core/$core")"
  if [ "$core" = mihomo ]; then
    command_line="$command_line -d $(service_systemd_arg "$config_dir")"
    restart_policy=always
    capabilities='CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_TIME CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE'
  else
    command_line="$command_line -D $(service_systemd_arg "$config_dir") -c $(service_systemd_arg "$config_dir/config.json") run"
    restart_policy=on-failure
    capabilities='CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH'
  fi
  wanted_by=multi-user.target
  if [ "$scope" = user ]; then wanted_by=default.target; fi
  cat <<EOF_SYSTEMD
[Unit]
Description=ClashTui $core core
After=network.target

[Service]
Type=simple
ExecStart=$command_line
ExecReload=/bin/kill -HUP \$MAINPID
Restart=$restart_policy
RestartSec=5s
LimitNOFILE=1000000
EOF_SYSTEMD
  if [ "$scope" = system ]; then
    cat <<EOF_SYSTEMD
User=$core
Group=$core
CapabilityBoundingSet=$capabilities
AmbientCapabilities=$capabilities
EOF_SYSTEMD
  fi
  cat <<EOF_SYSTEMD

[Install]
WantedBy=$wanted_by
EOF_SYSTEMD
}

render_launchd() {
  local core="$1" install_dir="$2" log_dir="$3" name config_dir
  name=$(service_name "$core") || return 1
  config_dir="$install_dir/$core/config"
  cat <<EOF_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$name</string>
    <key>ProgramArguments</key>
    <array>
        <string>$(service_xml_text "$install_dir/$core/$core")</string>
EOF_PLIST
  if [ "$core" = mihomo ]; then
    cat <<EOF_PLIST
        <string>-d</string>
        <string>$(service_xml_text "$config_dir")</string>
EOF_PLIST
  else
    cat <<EOF_PLIST
        <string>-D</string>
        <string>$(service_xml_text "$config_dir")</string>
        <string>-c</string>
        <string>$(service_xml_text "$config_dir/config.json")</string>
        <string>run</string>
EOF_PLIST
  fi
  cat <<EOF_PLIST
    </array>
    <key>Disabled</key><true/>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>WorkingDirectory</key><string>$(service_xml_text "$config_dir")</string>
    <key>StandardOutPath</key><string>$(service_xml_text "$log_dir/$name.log")</string>
    <key>StandardErrorPath</key><string>$(service_xml_text "$log_dir/$name.log")</string>
</dict>
</plist>
EOF_PLIST
}

render_openrc() {
  local core="$1" scope="$2" install_dir="$3" name config_dir command_line
  name=$(service_name "$core") || return 1
  config_dir="$install_dir/$core/config"
  if [ "$core" = mihomo ]; then
    command_line="-d $(service_shell_arg "$config_dir")"
  else
    command_line="-D $(service_shell_arg "$config_dir") -c $(service_shell_arg "$config_dir/config.json") run"
  fi
  # System services run as root so TUN works without changing binary capabilities.
  cat <<EOF_OPENRC
#!/sbin/openrc-run

supervisor="supervise-daemon"
name="$name"
description="ClashTui $core core"
command=$(service_shell_arg "$install_dir/$core/$core")
command_args=$(service_shell_arg "$command_line")
EOF_OPENRC
  if [ "$scope" = system ]; then
    cat <<'EOF_OPENRC'
pidfile="/run/${RC_SVCNAME}.pid"
EOF_OPENRC
  fi
  cat <<'EOF_OPENRC'

depend() {
    need net
}
EOF_OPENRC
}

# Pure rendering: only stdout changes. The caller publishes the returned content.
render_service() {
  local backend="$1" core="$2" scope="$3" install_dir="$4" log_dir="$5"
  case "$core" in mihomo|sing-box) ;; *) return 1 ;; esac
  case "$scope" in user|system) ;; *) return 1 ;; esac
  case "$install_dir$log_dir" in *$'\n'*|*$'\r'*) return 1 ;; esac
  case "$backend" in
    systemd) render_systemd "$core" "$scope" "$install_dir" ;;
    launchd) render_launchd "$core" "$install_dir" "$log_dir" ;;
    openrc) render_openrc "$core" "$scope" "$install_dir" ;;
    *) return 1 ;;
  esac
}

remove_service() {
  local backend="$1" core="$2" scope="$3" unit_dir="$4"
  local name file details result domain membership entry separator runlevel
  local -a service_command update_command
  name=$(service_name "$core") || die "Unsupported core: $core"
  file=$(service_filename "$backend" "$core") || die "Unsupported service controller: $backend"
  case "$scope" in user|system) ;; *) die "Unsupported service scope: $scope" ;; esac
  case "$backend" in
    systemd)
      service_command=(systemctl)
      if [ "$scope" = user ]; then service_command+=(--user); fi
      result=0
      details=$(as_scope "$scope" "${service_command[@]}" show --property=LoadState -- "$name.service") || result=$?
      if [ "$details" != 'LoadState=not-found' ]; then
        [ "$result" -eq 0 ] && [[ "$details" == LoadState=* ]] || die "Cannot inspect service: $name"
        as_scope "$scope" "${service_command[@]}" disable --now -- "$name.service" || die "Cannot stop and disable service: $name"
      fi
      ;;
    launchd)
      domain=system
      if [ "$scope" = user ]; then domain="gui/$(id -u)"; fi
      if details=$(as_scope "$scope" launchctl print "$domain/$name" 2>&1); then
        as_scope "$scope" launchctl bootout "$domain/$name" || die "Cannot unload service: $name"
      else
        case "$details" in
          *'Could not find service'*|*'Could not find specified service'*)
            as_scope "$scope" launchctl print "$domain" >/dev/null || die "Cannot inspect launchd domain: $domain"
            ;;
          *) die "Cannot inspect service $name: $details" ;;
        esac
      fi
      ;;
    openrc)
      service_command=(rc-service)
      update_command=(rc-update)
      if [ "$scope" = user ]; then service_command+=(--user); update_command+=(--user); fi
      result=0
      details=$(as_scope "$scope" "${service_command[@]}" --exists "$name" 2>&1) || result=$?
      if [ "$result" -eq 0 ]; then
        as_scope "$scope" "${service_command[@]}" "$name" stop || die "Cannot stop service: $name"
      elif [ "$result" -ne 1 ] || [ -n "$details" ]; then
        die "Cannot inspect service $name: $details"
      fi
      membership=$(as_scope "$scope" "${update_command[@]}" show default) || die "Cannot inspect OpenRC runlevel: default"
      while read -r entry separator runlevel; do
        if [ "$entry" = "$name" ] && [ "$separator" = '|' ] && [ "$runlevel" = default ]; then
          as_scope "$scope" "${update_command[@]}" del "$name" default || die "Cannot disable service: $name"
        fi
      done <<EOF_MEMBERSHIP
$membership
EOF_MEMBERSHIP
      ;;
  esac
  as_scope "$scope" rm -f -- "$unit_dir/$file"
}

create_service() {
  local core="$1" scope="$2" backend="$3" work="$4" log_dir file
  log_dir=/usr/local/var/log
  if [ "$scope" = user ]; then log_dir="$HOME/Library/Logs"; fi
  file=$(service_filename "$backend" "$core")
  render_service "$backend" "$core" "$scope" "$(installation_dir "$scope" "$backend")" "$log_dir" > "$work/$file"
  if [ "$backend" = launchd ]; then as_scope "$scope" mkdir -p "$log_dir"; fi
  local mode=644
  if [ "$backend" = openrc ]; then mode=755; fi
  publish_file "$work/$file" "$(service_dir "$scope" "$backend")/$file" "$mode" "$scope"
}

reload_services() {
  local scope="$1" backend="$2"
  if [ "$backend" = systemd ]; then
    if [ "$scope" = user ]; then systemctl --user daemon-reload
    else as_scope system systemctl daemon-reload
    fi
  fi
}

install_project() {
  local selection="$1" scope="$2" backend="$3" repo="$4" version="$5" templates="$6" rules_dat="$7" work="$8"
  local contrib_path="$9"
  local contrib directory core binary file
  contrib=$(prepare_contrib "$repo" "$version" "$work" "$contrib_path")
  validate_contrib "$contrib" "$selection" "$scope" "$backend" "$templates"
  directory=$(installation_dir "$scope" "$backend")

  # Finish downloads before changing the installed tree.
  prepare_binary clashtui "$directory/bin/clashtui" "$repo" "$version" "$work" > "$work/clashtui.source"
  for core in $(selected_cores "$selection"); do
    prepare_binary "$core" "$directory/$core/$core" "$repo" "$version" "$work" > "$work/$core.source"
  done
  if [ "$selection" != sing-box ] && [ "$rules_dat" = yes ]; then
    fetch 'https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb' "$work/geoip.metadb"
    fetch 'https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat' "$work/GeoSite.dat"
  fi

  for core in $(selected_cores "$selection"); do
    if [ "$scope" = system ] && [ "$backend" != launchd ]; then create_system_account "$core"; fi
    binary=$(cat "$work/$core.source")
    install_binary "$binary" "$directory/$core/$core" "$scope"
    install_core_config "$core" "$scope" "$backend" "$contrib" "$work"
    if [ "$templates" = yes ]; then install_templates "$core" "$contrib"; fi
    if [ "$core" = mihomo ] && [ "$rules_dat" = yes ]; then
      for file in geoip.metadb GeoSite.dat; do
        publish_file "$work/$file" "$directory/$core/config/$file" 664 "$scope"
      done
    fi
    if [ "$scope" = system ]; then fix_config_permissions "$core" "$directory/$core/config" "$backend"; fi
    create_service "$core" "$scope" "$backend" "$work"
  done
  binary=$(cat "$work/clashtui.source")
  install_binary "$binary" "$directory/bin/clashtui" "$scope"
  install_user_config "$contrib" "$scope" "$backend" "$work"
  if [ "$scope" = system ]; then
    if [ ! -e /usr/local/bin/clashtui ] && [ ! -L /usr/local/bin/clashtui ]; then
      as_scope system mkdir -p /usr/local/bin
      as_scope system ln -s "$directory/bin/clashtui" /usr/local/bin/clashtui
    fi
  fi
  reload_services "$scope" "$backend"
  log_info "Installed: $directory/bin/clashtui"
  log_info "Config: $(user_config_dir)"
  log_info 'Open CoreSrvCtl in ClashTui to start one core and enable autostart.'
  if [ "$scope" = system ] && [ "$backend" != launchd ]; then
    log_warn 'Log out and back in to apply core group permissions (recommended).'
    log_warn 'Alternatively, run: su - "$(id -un)" (updates groups in the new shell only).'
  fi
}

remove_owned_link() {
  local link="$1" target="$2" scope="$3"
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    as_scope "$scope" rm -f "$link"
  fi
}

uninstall_project() {
  local selection="$1" scope="$2" backend="$3" directory core
  directory=$(installation_dir "$scope" "$backend")
  for core in $(selected_cores "$selection"); do
    remove_service "$backend" "$core" "$scope" "$(service_dir "$scope" "$backend")"
  done
  for core in $(selected_cores "$selection"); do
    # Preserve core configs and backups so uninstall does not discard profiles.
    as_scope "$scope" rm -f "$directory/$core/$core" "$directory/$core/$(service_name "$core").service"
    if [ "$scope" = system ] && [ "$core" = sing-box ]; then
      remove_owned_link /usr/bin/sing-box "$directory/sing-box/sing-box" system
    fi
  done
  if [ "$scope" = system ]; then remove_owned_link /usr/local/bin/clashtui "$directory/bin/clashtui" system; fi
  as_scope "$scope" rm -f "$directory/bin/clashtui"
  reload_services "$scope" "$backend"
  log_info "Uninstalled $selection and ClashTui; configs, backups, logs, and system accounts are preserved."
}

main() (
  set -eEuo pipefail
  # Bash clears errexit in command substitutions. Every unexpected command
  # failure must also terminate the substitution, before its result is published.
  trap 'die "Installer failed at line $LINENO"' ERR
  export LC_ALL=C
  local action=install scope=system selection=all backend=auto-detect
  local repo=JohanChane/clashtui version=latest templates=yes rules_dat=yes no_prompt=false
  local contrib_path=
  local scope_set=false core_set=false templates_set=false rules_set=false work
  parse_options "$@"
  resolve_choices
  backend=$(resolve_backend "$backend")
  readonly action scope selection backend repo version templates rules_dat no_prompt contrib_path
  preflight "$scope" "$backend" "$no_prompt" "$action"
  if [ "$action" = uninstall ]; then
    uninstall_project "$selection" "$scope" "$backend"
  else
    work=$(mktemp -d "${TMPDIR:-/tmp}/clashtui-install.XXXXXX")
    trap 'rm -rf -- "$work"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    install_project "$selection" "$scope" "$backend" "$repo" "$version" "$templates" "$rules_dat" "$work" "$contrib_path"
  fi
)

# Only execute main when run directly (not sourced).
if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
